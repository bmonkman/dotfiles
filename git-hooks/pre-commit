#!/bin/bash
# Global pre-commit hook, enabled by core.hooksPath in .gitconfig.
# core.hooksPath replaces each repo's .git/hooks, so this runs the repo's own hook at the end.

git secrets --pre_commit_hook -- "$@" || exit 1

# Split so this file doesn't contain the marker and block its own commit
disallowed=("@no""commit")

# Checks the staged content, not the working file, so a fix that isn't staged yet still blocks.
while IFS= read -r -d '' file; do
  for word in "${disallowed[@]}"; do
    if git show ":$file" | grep -qE "$word"; then
      echo "ERROR: Disallowed expression \"${word}\" in file: ${file}" >&2
      exit 1
    fi
  done
done < <(git diff --cached --name-only --diff-filter=d -z)

# --git-common-dir rather than ./.git, so this also works from a worktree, where .git is a file
repo_hook="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [[ -x $repo_hook ]]; then
  exec "$repo_hook" "$@"
fi
